---
const jobs = [
  {
    date: "2022 — Presente",
    title: "Full Stack Developer",
    company: "Grupo Amedia",
    tasks: [
      "Mantenimiento evolutivo y correctivo de plataformas para clientes internacionales",
      "Desarrollo de nuevas funcionalidades usando C#, .NET MVC, Entity Framework, JavaScript, jQuery y SQL Server",
      "Implementación de mejoras de rendimiento y optimización de consultas en SQL Server",
      "Integración de servicios REST y consumo de APIs externas",
      "Gestión de versiones con Git (Bitbucket) y trabajo colaborativo en equipos ágiles bajo metodologías Scrum",
      "Diseño e implementación desde cero de una automatización con n8n que procesa mensajes de soporte mediante webhook y envía correos automáticos, mejorando la eficiencia operativa y reduciendo la carga manual"
    ],
    align: "left"
  },
  {
    date: "2020 — 2022",
    title: "Frontend Developer",
    company: "GSM TECH",
    tasks: [
      "Maquetación de interfaces web responsivas con HTML5, CSS3 y Flexbox/Grid",
      "Desarrollo de componentes interactivos utilizando React.js y JavaScript vanilla",
      "Optimización de performance en renderizado y carga de recursos",
      "Mantenimiento y ampliación de un simulador de manejo para custodias móviles"
    ],
    align: "right"
  }
];
---

<section id="experiencia" class="py-20 scroll-reveal">
  <div class="container mx-auto max-w-2xl">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
      Experiencia <span class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent">laboral</span>
    </h2>
    
    <div>
      {jobs.map((job, index) => (
        <div class={`relative pl-10 pb-12 last:pb-0 animate-fade-${job.align}`}>
          <!-- Vertical line -->
          <div class="absolute left-[15px] top-0 bottom-0 w-px bg-slate-700"></div>
          
          <!-- Dot -->
          <div class="absolute left-[8px] top-1 w-[15px] h-[15px] rounded-full bg-blue-500 border-2 border-slate-900"></div>
          
          <!-- Card -->
          <div class="bg-slate-800/30 border border-slate-700/50 rounded-lg p-6 hover:border-blue-500/30 transition-colors">
            <div class="flex items-center gap-2 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500">
                <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                <rect width="20" height="14" x="2" y="6" rx="2"></rect>
              </svg>
              <span class="text-sm text-blue-400 font-medium">{job.date}</span>
            </div>
            <h3 class="text-lg font-semibold text-white">{job.title}</h3>
            <p class="text-slate-400 text-sm mb-4">{job.company}</p>
            
            <ul class="space-y-2">
              {job.tasks.map((task) => (
                <li class="text-slate-400 text-sm flex items-start gap-2">
                  <span class="text-blue-500 mt-1">▸</span>
                  {task}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  
  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  .animate-fade-left {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .animate-fade-right {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .animate-fade-left.visible,
  .animate-fade-right.visible {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.scroll-reveal, .animate-fade-left, .animate-fade-right').forEach((el) => {
    observer.observe(el);
  });
</script>
