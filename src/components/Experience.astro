---
const jobs = [
  {
    date: "2022 — Presente",
    title: "Desarrollador .NET",
    company: "Grupo Amedia",
    description: "Desarrollo y mantenimiento de aplicaciones web con ASP.NET Core, Entity Framework y SQL Server. Participación en equipos ágiles con Scrum y Azure DevOps.",
    align: "left"
  },
  {
    date: "2020 — 2022",
    title: "Desarrollador de Software",
    company: "Grupo San Miguel",
    description: "Diseño e implementación de sistemas internos de gestión, reportes y automatización de procesos utilizando C#, .NET Framework y bases de datos SQL Server.",
    align: "right"
  }
];
---

<section id="experiencia" class="py-20 scroll-reveal">
  <div class="container mx-auto max-w-2xl">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
      Experiencia <span class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent">laboral</span>
    </h2>
    
    <div>
      {jobs.map((job, index) => (
        <div class={`relative pl-10 pb-12 last:pb-0 animate-fade-${job.align}`}>
          <!-- Vertical line -->
          <div class="absolute left-[15px] top-0 bottom-0 w-px bg-slate-700"></div>
          
          <!-- Dot -->
          <div class="absolute left-[8px] top-1 w-[15px] h-[15px] rounded-full bg-blue-500 border-2 border-slate-900"></div>
          
          <!-- Card -->
          <div class="bg-slate-800/30 border border-slate-700/50 rounded-lg p-6 hover:border-blue-500/30 transition-colors">
            <div class="flex items-center gap-2 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500">
                <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                <rect width="20" height="14" x="2" y="6" rx="2"></rect>
              </svg>
              <span class="text-sm text-blue-400 font-medium">{job.date}</span>
            </div>
            <h3 class="text-lg font-semibold text-white">{job.title}</h3>
            <p class="text-slate-400 text-sm mb-2">{job.company}</p>
            <p class="text-slate-400 text-sm leading-relaxed">{job.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  
  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  .animate-fade-left {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .animate-fade-right {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .animate-fade-left.visible,
  .animate-fade-right.visible {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.scroll-reveal, .animate-fade-left, .animate-fade-right').forEach((el) => {
    observer.observe(el);
  });
</script>
