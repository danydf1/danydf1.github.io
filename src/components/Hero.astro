---
interface Props {
  githubUrl?: string;
  linkedinUrl?: string;
  email?: string;
}

const { 
  githubUrl = "https://github.com/DanielFernandez19",
  linkedinUrl = "https://www.linkedin.com/in/daniel-david-fernandez-7444531b9/",
  email = "mailto:danydf1997@gmail.com"
} = Astro.props;

const stack = ["C#", ".NET Core", "SQL Server", "React", "Next.js", "AWS EC2", "REST APIs"];
---

<section id="hero" class="min-h-screen flex flex-col items-center justify-center text-center px-4 relative scroll-reveal">
  <div class="animate-fade-in">
    <p class="text-blue-400 text-sm tracking-widest uppercase mb-4">Hola, soy</p>
    
    <h1 class="text-5xl md:text-7xl font-bold mb-4">
      Daniel <span class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent">Fernandez</span>
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-400 mb-2">.NET Developer</p>
    
    <p class="text-slate-400 max-w-lg mx-auto mb-8">
      Desarrollador .NET con experiencia en APIs, bases de datos y despliegue en la nube.
    </p>
    
    <!-- Stack tags -->
    <div class="flex flex-wrap justify-center gap-2 mb-8">
      {stack.map((tech) => (
        <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 text-blue-300 text-sm rounded-md">
          {tech}
        </span>
      ))}
    </div>
    
    <!-- Social Links -->
    <div class="flex items-center justify-center gap-4 mb-8">
      <!-- GitHub -->
      <a 
        href={githubUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="p-3 rounded-full border border-slate-700 hover:border-blue-500 hover:text-blue-400 text-slate-400 transition-all" 
        aria-label="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      
      <!-- LinkedIn -->
      <a 
        href={linkedinUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="p-3 rounded-full border border-slate-700 hover:border-blue-500 hover:text-blue-400 text-slate-400 transition-all" 
        aria-label="LinkedIn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
      
      <!-- Email -->
      <a 
        href={email} 
        class="p-3 rounded-full border border-slate-700 hover:border-blue-500 hover:text-blue-400 text-slate-400 transition-all" 
        aria-label="Email"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
    </div>
    
    <!-- CTA Button -->
    <a 
      href="#contact" 
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium bg-blue-500 text-white hover:bg-blue-600 h-11 rounded-md px-8 transition-colors"
    >
      Contactame
    </a>
  </div>
  
  <!-- Scroll indicator -->
  <a href="#Proyects" class="absolute bottom-10 animate-bounce text-slate-500 hover:text-blue-400 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </a>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
  
  .scroll-reveal {
    opacity: 0;
  }
  
  .scroll-reveal.visible {
    opacity: 1;
  }
</style>

<script>
  // Simple fade-in on load
  document.addEventListener('DOMContentLoaded', () => {
    const hero = document.querySelector('#hero');
    setTimeout(() => {
      hero?.classList.add('visible');
    }, 100);
  });
</script>
