---
interface Props {
  company: string
  date: string
  task: string[]
}

const { company, date, task } = Astro.props
---
<div class="relative mb-10 group">
  <div class="absolute left-0 w-3 h-3 bg-blue-500 rounded-full -translate-x-[13px] -translate-y-1 ring-4 ring-slate-900 group-hover:bg-blue-400 transition-colors"></div>
  
  <div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-6 hover:border-blue-500/30 transition-colors">
    <h3 class="text-xl font-bold text-white mb-1">
      {company}
    </h3>
    <p class="text-sm text-blue-400 mb-4 font-medium">
      {date}
    </p>
    <ul class="space-y-2">
      {task.map((t) => (
        <li class="text-slate-400 text-sm flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          {t}
        </li>
      ))}
    </ul>
  </div>
</div>
