---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  imageUrl?: string;
  url: string;
}

const { title, description, tags = [], imageUrl, url } = Astro.props;
---

<a 
  href={url} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="group block bg-slate-800/30 border border-slate-700/50 rounded-xl overflow-hidden hover:border-blue-500/50 hover:bg-slate-800/50 transition-all duration-300"
>
  {
    imageUrl && (
      <div class="aspect-video overflow-hidden bg-slate-900/50">
        <img
          src={imageUrl}
          alt={title}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="p-5">
    <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-blue-400 transition-colors">
      {title}
    </h3>
    <p class="text-slate-400 text-sm mb-4 line-clamp-2">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-1 bg-blue-500/10 text-blue-400 border border-blue-500/20 rounded-md">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
